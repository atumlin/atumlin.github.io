@inproceedings{aquino_toxic_2021,
	title = {Toxic {Comment} {Detection}: {Analyzing} the {Combination} of {Text} and {Emojis}},
	shorttitle = {Toxic {Comment} {Detection}},
	url = {https://ieeexplore.ieee.org/document/9637812},
	doi = {10.1109/MASS52906.2021.00097},
	abstract = {Detection of toxicity in online commentary is a growing branch of Natural Language Processing (NLP). Most research in the area rely only on text-based toxic comment detection. We propose a machine learning approach for detecting the toxicity of a comment by analyzing both the text and the emojis within the comment. Our approach utilizes word embeddings derived from GloVe and emoji2vec to train a bidirectional Long Short Term Memory (biLSTM) model. We also create a new labeled dataset with comments with text and emojis. The accuracy score of our model on preliminary data is 0.911.},
	urldate = {2023-12-13},
	booktitle = {2021 {IEEE} 18th {International} {Conference} on {Mobile} {Ad} {Hoc} and {Smart} {Systems} ({MASS})},
	author = {Aquino, Michael and Ortiz, Yasiris and Rashid, Arif and Tumlin, Anne M. and Artan, N. Sertac and Dong, Ziqian and Gu, Huanying},
	month = oct,
	year = {2021},
	note = {ISSN: 2155-6814},
	pages = {661--662},
	file = {IEEE Xplore Abstract Record:/Users/annetumlin/Zotero/storage/NX97XPJS/9637812.html:text/html;IEEE Xplore Full Text PDF:/Users/annetumlin/Zotero/storage/AXM3JCJD/Aquino et al. - 2021 - Toxic Comment Detection Analyzing the Combination.pdf:application/pdf},
}

@inproceedings{olsen_visibility_2021,
	title = {A {Visibility} {Roadmap} {Sampling} {Approach} for a {Multi}-{Robot} {Visibility}-{Based} {Pursuit}-{Evasion} {Problem}},
	url = {https://ieeexplore.ieee.org/abstract/document/9562021},
	doi = {10.1109/ICRA48506.2021.9562021},
	abstract = {Given a two-dimensional polygonal space, the multi-robot visibility-based pursuit-evasion problem tasks several pursuer robots with the goal of establishing visibility with an arbitrarily fast evader. The best known complete algorithm for this problem takes time doubly exponential in the number of robots. However, sampling-based techniques have shown promise in generating feasible solutions in these scenarios. One of the primary drawbacks to employing existing sampling-based methods is that existing algorithms have long execution times and high failure rates for complex environments. This paper addresses that limitation by proposing a new algorithm that takes an environment as its input and returns a joint motion strategy which ensures that the evader is captured by one of the pursuers. Starting with a single pursuer, we sequentially construct Sample-Generated Pursuit-Evasion Graphs to create such a joint motion strategy. This sequential graph structure ensures that our algorithm will always terminate with a solution, regardless of the complexity of the environment. We describe an implementation of this algorithm and present quantitative results that show significant improvement in comparison to the existing algorithm.},
	urldate = {2023-12-13},
	booktitle = {2021 {IEEE} {International} {Conference} on {Robotics} and {Automation} ({ICRA})},
	author = {Olsen, Trevor and Tumlin, Anne M. and Stiffler, Nicholas M. and O’Kane, Jason M.},
	month = may,
	year = {2021},
	note = {ISSN: 2577-087X},
	pages = {7957--7964},
	file = {IEEE Xplore Full Text PDF:/Users/annetumlin/Zotero/storage/CC2H5IX4/Olsen et al. - 2021 - A Visibility Roadmap Sampling Approach for a Multi.pdf:application/pdf},
}
